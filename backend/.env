# Supabase Configuration - REPLACE THESE WITH YOUR ACTUAL VALUES
# Get these from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Redis Configuration (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secret (for session management if needed)
JWT_SECRET=

# Android Keystore (for APK signing)
ANDROID_KEYSTORE_PATH=/secrets/android.keystore
ANDROID_KEYSTORE_PASSWORD=changeme
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=changeme

# Environment
NODE_ENV=development
PORT=3000

# Rate Limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60
